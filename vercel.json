{
  "version": 2,
  "alias": ["update.colbe.cc"],
  "routes": [
    {
      "src": "/api/update/(?<platform>[^/]+)/(?<quality>[^/]+)/(?<commit>[^/]+)",
      "dest": "/api/update?platform=$platform&quality=$quality&commit=$commit"
    }
  ],
  "builds": [{ "src": "api/update/index.js", "use": "@vercel/node" }]
}